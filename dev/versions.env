# The one place the versions this project is built and tested with are pinned.
#
# Read by: dev/Dockerfile (through dev/run.sh, one --build-arg per line),
# .github/workflows/ci.yml (appended to $GITHUB_ENV), tests/lint.sh, and
# dev/install/*.sh when they run on their own.  Nothing else reads a version
# from anywhere else.  (Comments and docs that say "measured on tmux 3.7b"
# name the version a measurement was taken on, and stay as they are.)
#
# To move a version: edit it here, run `make pin` (which downloads what the new
# value names and records its sha256 in dev/checksums/), and commit both.  A
# version with no recorded checksum fails every build that fetches it, by name.
#
# Format, kept strict so the file means the same to sh, docker and GitHub's
# $GITHUB_ENV: KEY=value lines, comment lines starting with #, blank lines.
# No quotes, no spaces, no $: lists are comma-separated.  dev/run.sh refuses a
# line that breaks this.

# The base image of the dev container: the CI runner's distro, so a container
# run is a CI run.  (CI's runs-on names its image itself, ubuntu-24.04.)
BASE_IMAGE=ubuntu:24.04

# tmux, built from source (no distro on the CI image ships one new enough).
# The FLOOR is 3.6, and it is load-bearing: tmux <= 3.5a rewrites the raw US
# byte the row protocol puts inside -F formats as the four characters \037, so
# every row parses as one field and the picker is empty (3.4 -> 0 rows, 3.5a ->
# 0 rows, 3.6 -> works; docs/CI.md section 1).  Keep the pin at 3.7b or later:
# 3.7 and 3.7a mishandle the end of a synchronized update, and fzf >= 0.74.1
# wraps every frame in one.
TMUX_VERSION=3.7c

# fzf, the release binary.  0.74 is the floor the suites pin themselves to
# (INTERDIMUX_FZF_MINOR=74); apt's 0.44 turns the picker suites into skips.
# Pinned at the latest patch release, the one users run: the suites read fzf's
# screen, and 0.74.1-0.74.4 changed how it draws.
FZF_VERSION=0.74.4

# Real old fzf releases for tests/test_old_fzf.sh, which checks that the
# navigator opens AND draws on them: 0.40.0 is the README's floor, 0.44.1 and
# 0.52.1 are one per failure the suite guards.  The suite's own list is the
# authority; with INTERDIMUX_OLD_FZF_DIR set, a version it names that is not
# here FAILS it.
OLD_FZF_VERSIONS=0.40.0,0.44.1,0.52.1

# Real old bashes for tests/test_bash_floor.sh, built from the GNU tarballs.
# 3.2 (macOS's /bin/bash) and 4.2 (RHEL 7) must be refused in one line; 4.3 (the
# floor) to 5.1 re-expand a subscript in [[ -v a[$k] ]] that 5.2 does not, so
# all of them run.  Each is the newest tarball of its release (5.0 has no
# patch-level tarball).  Again the suite's list is the authority.
OLD_BASH_VERSIONS=3.2.57,4.2.53,4.3.30,4.4.18,5.0,5.1.16

# The one shellcheck tests/lint.sh accepts.  A newer one brings new SC codes and
# fails the lint with no change to the code (0.11.0 adds SC2329, among others).
SHELLCHECK_VERSION=0.10.0

# The Rust toolchain the core is built and tested with, here and in CI.  The
# MSRV is not pinned here: it is rust/Cargo.toml's rust-version, and the dev
# image installs that toolchain too, for `make msrv`.
RUST_VERSION=1.99.0
# The rustup that installs it, in the dev image.  Not named RUSTUP_VERSION:
# rustup reads that variable as the version to self-update to, and CI exports
# every line of this file.
RUSTUP_INIT_VERSION=1.29.1

# Linters the dev image runs on what tests/lint.sh does not cover
# (dev/lint-extra.sh): the workflow, the Dockerfile, and the docs' links.
ACTIONLINT_VERSION=1.7.12
HADOLINT_VERSION=2.15.1
LYCHEE_VERSION=0.24.2
